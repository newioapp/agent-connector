# Agent Connector — local build/runtime configuration.
#
# Copy this file to `.env` (which is gitignored) and fill in your own stage's
# values. The `dev` and `build:linux` package.json scripts load it via dotenv-cli.
# These values are baked into the bundle at `electron-vite build` time via the
# define block in electron.vite.config.ts.
#
# If no `.env` exists, the scripts fall back to the production defaults defined
# in electron.vite.config.ts (shown as the values below).

# Stage identifier: dev | integ | prod
NEWIO_STAGE=prod

# Backend REST + WebSocket endpoints for your stage.
API_BASE_URL=https://api.newio.app
WS_BASE_URL=wss://ws.newio.app

# Window/app display name (helps distinguish a dev build from a prod install).
APP_DISPLAY_NAME=Agent Connector

# Open Chromium DevTools and verbose logging during development.
ENABLE_DEV_TOOLS=false
LOG_LEVEL=info

# Proactive WebSocket reconnect interval in ms (empty = use client default).
WS_PROACTIVE_RECONNECT_MS=

# Auto-update feed URL (electron-builder generic provider). Where built
# artifacts + update manifests are published/served for your stage.
PUBLISH_URL=https://cdn.newio.app/downloads
