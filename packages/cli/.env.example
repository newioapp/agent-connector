# Internal testing config for the `newio` CLI / daemon.
#
# Copy this file to `.env` (gitignored) and fill in your non-prod backend URLs.
# With no `.env`, the CLI resolves to the `prod` stage and production endpoints.
#
# Run the CLI with these loaded via: `pnpm --filter @newio/cli dev <command>`

# Deployment stage — isolates the daemon's data dir, socket, and service unit.
# One of: dev | integ | prod
NEWIO_STAGE=dev

# Backend endpoints for the chosen stage. If unset, the CLI falls back to prod.
NEWIO_API_URL=https://api.<your-dev-stage>.example
NEWIO_WS_URL=wss://ws.<your-dev-stage>.example

# Download CDN for the chosen stage — where `newio update` reads version.json and
# fetches binaries. REQUIRED for self-update on a non-prod stage: unlike the API/WS
# URLs it does NOT fall back to prod (that would pull the prod channel), so a
# non-prod `newio update` refuses to run until this is set.
NEWIO_CDN_URL=https://cdn.<your-dev-stage>.example
