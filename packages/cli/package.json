{
  "name": "@newio/cli",
  "version": "0.1.0",
  "description": "Newio CLI and daemon — headless agent management",
  "license": "MIT",
  "type": "module",
  "bin": {
    "newio": "./dist/cli.js",
    "newio-connectord": "./dist/daemon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@newio/agent-engine": "workspace:*",
    "@newio/agent-sdk": "workspace:*",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
