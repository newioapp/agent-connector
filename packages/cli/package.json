{
  "name": "@newio/cli",
  "version": "0.1.0",
  "description": "Newio CLI and daemon — headless agent management",
  "license": "MIT",
  "type": "module",
  "bin": {
    "newio": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/index.*"
  ],
  "//publishConfig": "@newio/cli ships ONLY the `newio` binary to npm. The library export (DaemonConnector etc.) exists for the in-workspace Electron connector and is intentionally NOT importable from the published package: `exports` is stripped so the internal agent-engine/agent-sdk code bundled into the binary cannot be reached via `import '@newio/cli'`.",
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json"
    },
    "main": null,
    "module": null,
    "types": null
  },
  "scripts": {
    "build": "tsup",
    "build:sea": "node scripts/build-sea.mjs",
    "build:pkg": "node scripts/build-pkg.mjs",
    "clean": "rm -rf dist build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "set -a && . ./.env && set +a && node dist/cli.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "ws": "^8.20.0",
    "yaml": "^2.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@newio/agent-engine": "workspace:*",
    "@newio/agent-sdk": "workspace:*",
    "@types/node": "^22.19.15",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
