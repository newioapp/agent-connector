{
  "name": "@newio/agent-engine",
  "version": "0.1.0",
  "description": "Core runtime engine for Newio AI agents — manages agent lifecycle, sessions, and MCP tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newioapp/agent-connector.git",
    "directory": "packages/agent-engine"
  },
  "homepage": "https://github.com/newioapp/agent-connector/tree/main/packages/agent-engine#readme",
  "bugs": "https://github.com/newioapp/agent-connector/issues",
  "keywords": [
    "newio",
    "agent",
    "engine",
    "messaging",
    "ai",
    "mcp"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mcp-bridge": "./dist/mcp/bridge.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@newio/agent-sdk": "workspace:*",
    "ws": "^8.20.0",
    "yaml": "^2.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  },
  "peerDependencies": {
    "blurhash": "^2.0.5",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "blurhash": {
      "optional": true
    }
  }
}
