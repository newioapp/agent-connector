# LLM judge used to score eval runs (static + interactive).
# Loaded into process.env via dotenv when you run `pnpm eval` / `pnpm eval:interactive`.
# Copy to `.env` and fill in JUDGE_API_KEY.

# Judge provider: anthropic | openai
JUDGE_PROVIDER=anthropic

# API key for the judge provider (Anthropic: sk-ant-..., OpenAI: sk-...).
# Required — the judge errors out without it.
JUDGE_API_KEY=

# Judge model id (must be valid for JUDGE_PROVIDER).
#   Anthropic: claude-opus-4-8 (strongest judge), claude-sonnet-4-6 (cheaper)
#   OpenAI:    gpt-4o, o3
JUDGE_MODEL=claude-opus-4-8
