{
  "name": "@newio/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Platform end-to-end tests: desktop/human ↔ backend ↔ connector ↔ puppet agent",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "test:e2e": "pnpm --filter \"@newio/e2e...\" run build && RUN_E2E=1 vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@newio/acp-puppet": "workspace:*",
    "@newio/agent-engine": "workspace:*",
    "@newio/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.3"
  }
}
