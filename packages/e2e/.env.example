# Backend URLs for the @newio/e2e tests (live e2e + the puppet-driven harnesses).
# Copy this file to packages/e2e/.env and fill in your dev backend hostnames.
# .env is gitignored — the real hostnames are private and must not be committed.
NEWIO_API_URL=https://api.<your-dev-host>.newio.app
NEWIO_WS_URL=wss://ws.<your-dev-host>.newio.app
